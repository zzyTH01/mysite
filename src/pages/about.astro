---
import BaseLayout from "../layouts/BaseLayout.astro";
import TagList from "../components/TagList.astro";
import { publicProfile, siteConfig } from "../config/site";
import { with_base } from "../lib/paths";
---

<BaseLayout title="关于 · 高瞻远瞩" description={`${siteConfig.id}的个人档案：${publicProfile.focus}`}>
  <section class="container page">
    <p class="eyebrow">ABOUT</p>
    <h1 class="page-title">{siteConfig.id}</h1>

    <article class="profile-card" data-reveal>
      <p class="eyebrow">NETWORK ID</p>
      <p class="lead">{siteConfig.role} / {siteConfig.tagline}</p>
      <p>{publicProfile.focus}</p>
      <TagList tags={[...siteConfig.keywords]} />
      <div class="simple-actions">
        <a class="resource-button" href="https://github.com/zzyTH01" target="_blank" rel="noopener noreferrer">
          <span class="command-label">GitHub</span>
          <span class="command-detail">查看公开项目</span>
        </a>
        <a class="ghost-button" href={with_base("/")}>返回首页</a>
      </div>
    </article>

    <section class="profile-section" data-reveal>
      <div class="section-heading">
        <span class="section-slash" aria-hidden="true"></span>
        <div>
          <p class="section-code">PROJECTS / 03</p>
          <h2>精选项目</h2>
        </div>
      </div>

      <div class="project-grid">
        {publicProfile.projects.map((project) => (
          <article class="card project-card">
            <a class="card-link project-link" href={project.href} target="_blank" rel="noopener noreferrer">
              <span class="card-corner" aria-hidden="true"></span>
              <div class="card-meta">
                <span class="project-domain">OPEN SOURCE</span>
                <span class="card-kind">REPO</span>
              </div>
              <h3>{project.title}</h3>
              <p>{project.description}</p>
              <TagList tags={[...project.tags]} />
            </a>
          </article>
        ))}
      </div>
    </section>
  </section>
</BaseLayout>
