---
import BaseLayout from "../layouts/BaseLayout.astro";
import TagList from "../components/TagList.astro";
import { siteConfig } from "../config/site";
import { with_base } from "../lib/paths";

const stats = [
  { label: "摄影", value: 82 },
  { label: "骑行", value: 88 },
  { label: "音乐", value: 78 },
  { label: "二次元", value: 92 },
  { label: "赛车", value: 84 },
  { label: "Vibe", value: 99 },
];
---

<BaseLayout title="关于 · 高瞻远瞩" description={siteConfig.description}>
  <section class="container page">
    <p class="eyebrow">KNOW THE PERSON</p>
    <h1 class="page-title">关于档案</h1>

    <div class="profile-grid">
      <article class="profile-card" data-reveal>
        <p class="eyebrow">DRIVER PROFILE</p>
        <p class="lead">我是{siteConfig.id}，一名{siteConfig.role}。我把学习、城市、速度和爱好放进同一个观察系统：赛车教我看节奏与决策，骑行让我理解距离，摄影保存光线，音乐和二次元保存情绪。</p>
        <TagList tags={[...siteConfig.keywords]} />
        <ul class="profile-details">
          <li><strong>Role</strong><span>{siteConfig.role}</span></li>
          <li><strong>Base</strong><span>中国</span></li>
          <li><strong>Status</strong><span>学习 / 记录 / 探索中</span></li>
          <li><strong>Contact</strong><span>{siteConfig.email}</span></li>
        </ul>
      </article>

      <ul class="stat-list" data-reveal aria-label="兴趣强度">
        {stats.map((stat) => (
          <li class="stat-row">
            <span>{stat.label}</span>
            <span class="stat-track"><span class="stat-fill" style={`width:${stat.value}%`}></span></span>
            <span class="stat-value">{stat.value}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="about-grid">
      <section class="about-card" data-reveal>
        <h2>Education</h2>
        <p>当前为占位信息：在校学生，学习方向持续探索中。</p>
        <p class="muted">后续可以在这里补充学校、专业、时间段和代表性课程。</p>
      </section>
      <section class="about-card" data-reveal>
        <h2>Projects</h2>
        <ul>
          <li><strong>个人网站</strong>：记录观点、博客和生活。</li>
          <li><strong>城市骑行记录</strong>：保存路线、感受与街头照片。</li>
          <li><strong>摄影小集</strong>：关注光线、红色元素和城市节奏。</li>
        </ul>
      </section>
      <section class="about-card" data-reveal>
        <h2>Skills</h2>
        <ul>
          <li>内容写作：博客、短观点、生活记录。</li>
          <li>视觉观察：街头摄影、光线与构图。</li>
          <li>运动习惯：城市骑行与节奏训练。</li>
          <li>兴趣研究：动画、赛车、音乐现场。</li>
        </ul>
      </section>
      <section class="about-card" data-reveal>
        <h2>Contact</h2>
        <p>欢迎交流学习、摄影、骑行或个人网站相关的话题。</p>
        <ul class="footer-links">
          {siteConfig.social.map((item) => (
            <li>
              <a
                href={item.href}
                target={item.external ? "_blank" : undefined}
                rel={item.external ? "noopener noreferrer" : undefined}
              >{item.label}</a>
            </li>
          ))}
        </ul>
        <a class="resource-button" href={with_base("/downloads/gaozhangyuanzhu-resume.pdf")} download>
          <span class="command-label">GET CV</span>
          <span class="command-detail">下载简历 PDF</span>
        </a>
      </section>
    </div>
  </section>
</BaseLayout>
