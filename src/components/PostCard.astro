---
import TagList from "./TagList.astro";
import { format_date } from "../lib/content";
import { with_base } from "../lib/paths";

interface Props {
  title: string;
  href: string;
  date: Date;
  summary: string;
  tags: string[];
  kind?: string;
}

const { title, href, date, summary, tags, kind = "FILE" } = Astro.props;
---

<article class="card post-card">
  <a class="card-link" href={with_base(href)}>
    <span class="card-corner" aria-hidden="true"></span>
    <div class="card-meta">
      <time datetime={date.toISOString()}>{format_date(date)}</time>
      <span class="card-kind">{kind}</span>
    </div>
    <h3>{title}</h3>
    <p>{summary}</p>
    <TagList tags={tags} />
  </a>
</article>
