---
import TagList from "./TagList.astro";
import type { Resource } from "../data/resources";

interface Props {
  resource: Resource;
}

const { resource } = Astro.props;
const localFile = resource.type === "file" && resource.href.startsWith("/");
---

<article class="card resource-card">
  <div class="resource-meta">
    <span>{resource.category}</span>
    <time datetime={resource.date}>{resource.date}</time>
  </div>
  <h3>{resource.title}</h3>
  <p>{resource.description}</p>
  <TagList tags={resource.tags} />
  <a
    class="resource-button"
    href={resource.href}
    download={localFile ? "" : undefined}
    target={resource.type === "link" ? "_blank" : undefined}
    rel={resource.type === "link" ? "noopener noreferrer" : undefined}
  >
    {resource.type === "file" ? "下载资源" : "打开链接"}
  </a>
</article>
