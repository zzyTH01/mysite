---
import ThemeToggle from "./ThemeToggle.astro";
import { navItems } from "../config/site";
import { with_base } from "../lib/paths";

const pathname = Astro.url.pathname;
const isActive = (href: string) => href === "/" ? pathname === "/" : pathname.startsWith(href);
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={with_base("/")}>
      <span class="brand-mark" aria-hidden="true"></span>
      <span>高瞻远瞩</span>
    </a>
    <nav class="desktop-nav" aria-label="主导航">
      {navItems.map((item) => (
        <a class:list={["nav-link", { active: isActive(item.href) }]} aria-current={isActive(item.href) ? "page" : undefined} href={with_base(item.href)}>{item.label}</a>
      ))}
    </nav>
    <div class="header-actions">
      <ThemeToggle />
      <button class="mobile-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
        <span class="sr-only">打开导航菜单</span>
        <span aria-hidden="true">菜单</span>
      </button>
    </div>
  </div>
  <nav id="site-nav" class="mobile-nav" aria-label="移动端导航">
    {navItems.map((item) => (
      <a class:list={["mobile-nav-link", { active: isActive(item.href) }]} aria-current={isActive(item.href) ? "page" : undefined} href={with_base(item.href)}>{item.label}</a>
    ))}
  </nav>
</header>
<script>
  const toggle = document.querySelector(".mobile-toggle");
  const menu = document.querySelector("#site-nav");
  toggle?.addEventListener("click", () => {
    const expanded = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!expanded));
    menu?.classList.toggle("open");
  });
</script>
